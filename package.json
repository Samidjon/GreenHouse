{
  "name": "greenhouse",
  "version": "0.1.0",
  "private": true,
  "description": "A cozy 2D browser gardening simulator.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "assets": "node scripts/generate-assets.mjs",
    "verify": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "dexie": "^4.4.7",
    "next": "^16.4.5",
    "phaser": "^3.90.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "fake-indexeddb": "^6.2.7",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
